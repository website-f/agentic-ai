# VPS settings for docker-compose.vps.yml. Copy to .env and fill in every value.
# Generate secrets with:  python3 deploy/scripts/gen-secrets.py
# Keep a copy of this file somewhere safe (a password manager): without AGENTIC_MASTER_KEY
# the saved provider keys and channel tokens cannot be decrypted, even from a backup.

# Public address, served by the reverse proxy (see docs/DOCKER-AND-DEPLOY.md, VPS deploy).
AGENTIC_DOMAIN=agents.example.com
# Where people open the app: links in messages, Google sign-in callback.
AGENTIC_PUBLIC_URL=https://agents.example.com
# The only published port, on 127.0.0.1. Caddy upstream: 127.0.0.1:8500
AGENTIC_PORT=8500
TEMPORAL_UI_PORT=8502

AGENTIC_SECRET_KEY=
AGENTIC_MASTER_KEY=
AGENTIC_DB_PASSWORD=
TEMPORAL_DB_PASSWORD=

# Backups: nightly at BACKUP_HOUR (BACKUP_TZ) into an encrypted restic repository.
RESTIC_PASSWORD=
AGENTIC_BROWSER_TOKEN=
AGENTIC_SANDBOX_TOKEN=
AGENTIC_WAHA_API_KEY=
# Agent browser egress proxy (optional): extra hosts the browser may reach even if they are
# private (host or host:port, comma-separated), and ports other than 80,443.
# EGRESS_ALLOW_HOSTS=
# EGRESS_ALLOW_PORTS=80,443
# Route specific sites out through a trusted upstream proxy on another line (your own office/
# home PC over a Tailscale/WireGuard tunnel), so they exit THAT line's IP instead of this
# datacenter IP. Needed when a portal (ePerolehan) blocks datacenter ranges. Everything else
# still exits this host directly. See docs/EPEROLEHAN-EXIT-IP.md. Leave empty = off.
# EGRESS_UPSTREAM=100.x.y.z:3129
# EGRESS_UPSTREAM_HOSTS=eperolehan.gov.my,mda.gov.my
BACKUP_HOUR=3
BACKUP_TZ=Asia/Kuala_Lumpur
# Local folder (owned by uid 10001). Better: a second disk, e.g. /mnt/backup/agentic
BACKUP_DIR=./data/backups
# Offsite instead (any restic backend), e.g. Backblaze B2:
# RESTIC_REPOSITORY=b2:my-bucket:agentic
# B2_ACCOUNT_ID=
# B2_ACCOUNT_KEY=
# or S3-compatible:
# RESTIC_REPOSITORY=s3:https://s3.example.com/my-bucket/agentic
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
BACKUP_INCLUDE_SECRETS=true

# Hosts allowed to resolve to private IPs (e.g. a LAN Ollama box). Empty = none.
AGENTIC_PRIVATE_HOSTS_ALLOWED=
AGENTIC_DREAM_HOUR=2

# Memory on a shared server: unload the local backup model after 30 idle minutes (~0.8 GB).
OLLAMA_KEEP_ALIVE=30m
# Pin WhatsApp gateway versions so a restart never pulls an image that can't read the session.
WAHA_IMAGE=devlikeapro/waha:latest
# Add `demo` for the practice supplier portal (agents' browser tests).
COMPOSE_PROFILES=

# Postgres sizing for a 4-8 GB VPS.
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE=1536MB
