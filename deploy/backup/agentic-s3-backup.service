# P149a: nightly backup of the office and Prima databases and the vault/media/files volumes to
# the company's S3 file server (s3backup.py). Credentials: /root/.grey-s3.env (read by the
# script at run time, never logged). Install:
#   install -m 644 deploy/backup/agentic-s3-backup.service deploy/backup/agentic-s3-backup.timer \
#       /etc/systemd/system/ && systemctl daemon-reload && systemctl enable --now agentic-s3-backup.timer
[Unit]
Description=Agentic office backup to the S3 file server
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/agentic-ai/deploy/backup/s3backup.py run
WorkingDirectory=/root
# Gentle on the server: low CPU and disk priority, at most 4 hours.
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUQuota=150%
TimeoutStartSec=4h
