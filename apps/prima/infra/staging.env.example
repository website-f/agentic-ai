# Prima staging settings: IDs and names only, never passwords, keys or tokens. Copy to infra/staging.env and fill in
# the IDs (Azure portal, or the output of infra/bootstrap-staging.sh). infra/staging-env.sh checks every line.
#
# Azure subscription and directory (tenant) that hold rg-prima-staging-sea.
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# The GitHub deployment identity ("prima-github-deploy-staging", federated to main only). Application (client) ID.
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Microsoft sign-in registrations: "Prima Secure App - Staging" (website) and "Prima Secure API - Staging".
ENTRA_SPA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_API_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Only when the API's Application ID URI is not api://<ENTRA_API_CLIENT_ID>:
# ENTRA_API_APP_ID_URI=api://...
# The two public addresses, with no trailing slash.
WEB_ORIGIN=https://ashy-field-095365900.3.azurestaticapps.net
API_URL=https://ca-prima-api-staging.yellowsand-230f2038.southeastasia.azurecontainerapps.io
# The Container Apps job that runs the database setup (node dist/src/db-setup.js) as id-prima-staging-dbsetup.
SETUP_JOB=caj-prima-dbsetup-staging
#
# These are fixed by infra/staging-env.sh to the real resources; listing them here is optional, changing them is refused.
# RG=rg-prima-staging-sea
# PG=psql-prima-staging-sea
# PG_DATABASE=appdb
# ACR=acrprimastagingsea
# CAE=cae-prima-staging-sea
# API_APP=ca-prima-api-staging
# SWA=swa-prima-staging
# KV=kv-prima-staging-sea
# APP_IDENTITY=id-prima-staging-app
# DBSETUP_IDENTITY=id-prima-staging-dbsetup
