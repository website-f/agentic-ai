# Copy to .env for local runs. Never commit real values.
DATABASE_URL=postgres://postgres@localhost:5432/prima
# Signs development login tokens. Production uses Microsoft Entra ID instead.
DEV_TOKEN_SECRET=change-me-local-only
PORT=3000
# What the records are, shown on screens: staging-pilot when pilot staff do real work on staging. Anything else, or
# unset, shows "Test data." (the safe default).
PRIMA_DATA_MODE=
# Allow the dev login endpoint (never in production).
ALLOW_DEV_LOGIN=true
# Microsoft sign-in (Entra ID) for office staff. Two app registrations: the web app (single-page application) and
# the protected API. All IDs are public identifiers, not secrets; no client secret is used. Leave all empty to keep
# Microsoft sign-in off. (Older single-registration setups may set ENTRA_CLIENT_ID instead of the two client IDs.)
ENTRA_TENANT_ID=
# Application (client) ID of the web app registration, e.g. "Prima Secure App - Staging".
ENTRA_SPA_CLIENT_ID=
# Application (client) ID of the API registration, e.g. "Prima Secure API - Staging".
ENTRA_API_CLIENT_ID=
# The API registration's Application ID URI, only if it is not the default api://<API client ID>.
ENTRA_API_APP_ID_URI=
# The delegated scope the API registration exposes. Default access_as_user.
ENTRA_SCOPE=access_as_user
# Azure only: the website address allowed to call the API from a browser (comma-separated). Unset locally.
WEB_ORIGIN=
# Database setup job only (node dist/src/db-setup.js, run as the database administrator): the API's own
# least-privilege login it creates or updates, and Microsoft accounts to link on first setup (u-id=<object id>,...).
PRIMA_API_DB_USER=prima_api
PRIMA_API_DB_PASSWORD=
ENTRA_BOOTSTRAP_LINKS=
# Microsoft 365 Connections (docs/M365_CONNECTIONS.md). Off unless set; tenant consent needs CEO approval first.
# M365_CONNECTIONS_ENABLED=true
# M365_OUTLOOK_ENABLED=true
# M365_TEAMS_ENABLED=true
# M365_TEAMS_APPROVED_JSON=[{"key":"<team-key>","name":"<team name>","teamId":"<team-id>","companyIds":["<company-id>"]}]
# M365_OBO_CLIENT_SECRET=<from approved secret store, never committed>
