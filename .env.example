# Copy to .env and change for anything beyond local testing. Every value has a dev default.
# For a VPS use .env.vps.example instead (docker-compose.vps.yml makes every secret required).

# dev | prod. Outside dev the API refuses to start without a 32+ character secret key,
# a valid master key and secure cookies (see agentic/core/config.py, check()).
AGENTIC_ENV=dev
# Long random string. All secrets at once: python deploy/scripts/gen-secrets.py
AGENTIC_SECRET_KEY=dev-only-change-me
# true once the stack sits behind HTTPS (cookies become Secure). Required outside dev.
AGENTIC_COOKIE_SECURE=false

# Wraps every stored API key. Required outside dev; in dev it is derived from the secret.
# Keep a copy somewhere safe: without it, stored keys cannot be decrypted, even from a backup.
AGENTIC_MASTER_KEY=
# Hosts that may resolve to private IPs, comma separated (e.g. a LAN Ollama box). Empty = none.
AGENTIC_PRIVATE_HOSTS_ALLOWED=

# Dev only. With no users yet, the first start creates workspace "Qbot Group", branch
# "Qbot Studio Sdn Bhd" and one login per role: owner@, admin@, operator@, approver@,
# viewer@example.com, all with this password. Set false to get the setup page instead.
# Never runs when AGENTIC_ENV=prod.
AGENTIC_DEV_SEED=true
AGENTIC_SEED_PASSWORD=agentic-test-2026

# Brain vault (markdown + git, one folder per workspace). Default: a Docker volume.
# Point it at a folder on this PC to open the vault in Obsidian, e.g. ./data/vault
# AGENTIC_VAULT_DIR=./data/vault
# The nightly dream runs at this local hour (workspace time zone).
AGENTIC_DREAM_HOUR=2

AGENTIC_DB_PASSWORD=agentic_dev
TEMPORAL_DB_PASSWORD=temporal_dev

# Worker capacity: task steps running at once, and its database pool (2 per step + spare).
AGENTIC_WORKER_MAX_ACTIVITIES=16
AGENTIC_WORKER_DB_POOL=24

# Backups (on by default): nightly pg_dump + vault into an encrypted restic repository.
# docker compose run --rm backup backup | snapshots | check | restore   (docs/RUNBOOK.md)
RESTIC_PASSWORD=dev-only-backup-password
BACKUP_DIR=./data/backups
BACKUP_HOUR=3
BACKUP_TZ=Asia/Kuala_Lumpur
BACKUP_INCLUDE_SECRETS=true
# Offsite instead of a local folder (any restic backend):
# RESTIC_REPOSITORY=b2:my-bucket:agentic
# B2_ACCOUNT_ID=
# B2_ACCOUNT_KEY=

# Traces in a local Langfuse (adds about 2.5 GB RAM). Uncomment both lines, then
# docker compose up -d and open http://localhost:8503 (login: the dev owner above).
# COMPOSE_PROFILES=obs
# AGENTIC_LANGFUSE_HOST=http://langfuse-web:3000

# Host ports (all bound to 127.0.0.1).
WEB_PORT=8500
API_PORT=8501
TEMPORAL_UI_PORT=8502
LANGFUSE_PORT=8503
PG_DEV_PORT=8506
VALKEY_DEV_PORT=8507
TEMPORAL_DEV_PORT=8508
